<script>
  // 站内分节跳转只滚动，不写 #锚点：地址栏始终停在 /osimertinib
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = decodeURIComponent(link.getAttribute('href')!.slice(1));
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'start',
      });
      // 键盘用户需要焦点跟着走，否则读屏仍在原处
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  });

  // 同一个锚点可能同时有侧栏链接和移动端目录条目，按 id 归组后一起点亮
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link], [data-toc-chip]')];
  const byId = new Map<string, HTMLAnchorElement[]>();
  for (const link of navLinks) {
    const id = link.getAttribute('href')?.slice(1);
    if (!id) continue;
    const bucket = byId.get(id);
    if (bucket) bucket.push(link);
    else byId.set(id, [link]);
  }
  const currentLabel = document.querySelector('[data-toc-current-label]');

  if ('IntersectionObserver' in window && byId.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          byId.forEach((els, id) => {
            const active = id === entry.target.id;
            for (const el of els) el.setAttribute('data-active', String(active));
            // 收起状态下那一行要显示当前所在章节
            if (active && currentLabel && els[0]) {
              currentLabel.textContent = (els[0].textContent ?? '').trim();
            }
          });
        }
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    byId.forEach((_els, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // 移动端目录折叠：点标题条展开/收起，选中章节后自动收起
  const tocToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
  const tocPanel = document.getElementById('toc-panel');
  const tocChevron = document.querySelector('[data-toc-chevron]');
  if (tocToggle && tocPanel && tocChevron) {
    const setOpen = (open: boolean) => {
      tocToggle.setAttribute('aria-expanded', String(open));
      tocPanel.classList.toggle('hidden', !open);
      tocChevron.classList.toggle('rotate-180', open);
    };
    tocToggle.addEventListener('click', () => {
      setOpen(tocToggle.getAttribute('aria-expanded') !== 'true');
    });
    // 捕获阶段先收起：面板回缩会让正文上移，必须在滚动之前完成，否则落点偏移
    tocPanel.addEventListener(
      'click',
      (event) => {
        if ((event.target as HTMLElement | null)?.closest('a')) setOpen(false);
      },
      true,
    );
  }

  const bar = document.getElementById('reading-progress');
  if (bar) {
    const update = () => {
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      bar.style.width = `${max > 0 ? (el.scrollTop / max) * 100 : 0}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

</script>

